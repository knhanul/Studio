{
  "name": "gomo-compose-studio",
  "private": true,
  "version": "0.3.2",
  "description": "고모 미디어공방 — 고모 편집실 (창작실 작품 더빙·자막·배경음악·MP4 내보내기)",
  "main": "./out/main/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/brand.mjs dev",
    "build": "node scripts/brand.mjs build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/brand.mjs test",
    "dist:win": "node scripts/brand.mjs dist:win",
    "dist:dir": "node scripts/brand.mjs dist:dir",
    "test:render": "node scripts/brand.mjs test:render"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.1",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "com.nunistudio.compose",
    "productName": "누니 편집실",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "resources/brands/**/*"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "engine/bridge.py",
        "to": "engine/bridge.py"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/brands/nuni/app.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
