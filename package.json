{
  "name": "gomo-compose-studio",
  "private": true,
  "version": "0.1.0",
  "description": "고모 미디어공방 — 고모 편집실 (React UI + 기존 Python 영상 엔진 연결)",
  "main": "./out/main/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/test.mjs && python -m unittest discover -s engine/tests -v",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {"lucide-react":"^0.468.0", "react":"^19.3.1", "react-dom":"^19.3.1"},
  "devDependencies": {"@types/node":"^22.10.0", "@types/react":"^19.3.0", "@types/react-dom":"^19.0.0", "@vitejs/plugin-react":"^6.3.0", "electron":"^45.4.1", "electron-builder":"^26.18.1", "electron-vite":"^6.0.0", "typescript":"^5.9.3", "vite":"^8.3.8"},
  "build": {
    "appId":"com.gomoworkshop.compose", "productName":"고모 편집실",
    "directories":{"output":"release"},"files":["out/**/*","package.json"],"asar":true,
    "extraResources":[{"from":"engine/bridge.py","to":"engine/bridge.py"}],
    "win":{"target":["nsis","portable"],"icon":"resources/app.ico"},
    "nsis":{"oneClick":false,"allowToChangeInstallationDirectory":true,"createDesktopShortcut":true}
  },
  "engines":{"node":">=22.12.0"}
}
